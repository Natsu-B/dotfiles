configuration {
  modi: "drun";
  show-icons: true;
  font: "Noto Sans CJK JP 12";
  drun-display-format: "{name}";
  disable-history: true;
}
* {
  bg: #1e1e2ef2;
  fg: #cdd6f4;
  accent: #cba6f7;
  background-color: transparent;
  text-color: @fg;
}
window {
  location: center;
  anchor: center;
  width: 660px;
  border: 2px;
  border-color: @accent;
  border-radius: 16px;
  background-color: @bg;
}
mainbox { padding: 18px; spacing: 12px; children: [inputbar, listview]; }
inputbar { spacing: 10px; padding: 10px; border-radius: 10px; background-color: #313244; }
prompt { text-color: @accent; }
entry { placeholder: "Search apps or Action:"; }
listview { lines: 9; columns: 1; spacing: 5px; fixed-height: false; }
element { padding: 9px; spacing: 10px; border-radius: 8px; }
element selected { background-color: #45475a; }
element-icon { size: 24px; }
element-text { vertical-align: 0.5; }
