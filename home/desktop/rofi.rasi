configuration {
  modi: "drun";
  show-icons: true;
  font: "Noto Sans CJK JP 12";
  drun-display-format: "{name}";
  disable-history: true;
}
* {
  bg: #1e1e2e;
  fg: #cdd6f4;
  accent: #cba6f7;
  background-color: transparent;
  text-color: @fg;
}
window {
  location: center;
  anchor: center;
  width: 660px;
  border: 2px;
  border-color: @accent;
  border-radius: 16px;
  background-color: @bg;
}
mainbox { padding: 18px; spacing: 12px; children: [inputbar, listview]; }
inputbar { spacing: 10px; padding: 10px; border-radius: 10px; background-color: #313244; }
prompt { text-color: @accent; }
entry { text-color: @fg; placeholder: "Search apps or Action:"; }
listview { lines: 9; columns: 1; spacing: 5px; fixed-height: false; }
element { padding: 9px; spacing: 10px; border: 2px; border-color: transparent; border-radius: 8px; }
element normal.normal, element alternate.normal {
  background-color: transparent;
  text-color: @fg;
}
element normal.active, element alternate.active {
  background-color: transparent;
  text-color: @accent;
}
element normal.urgent, element alternate.urgent {
  background-color: transparent;
  text-color: #f38ba8;
}
element selected.normal, element selected.active, element selected.urgent {
  background-color: @accent;
  text-color: #1e1e2e;
  border-color: #f5e0dc;
}
element-icon { size: 24px; }
element-text { vertical-align: 0.5; }
