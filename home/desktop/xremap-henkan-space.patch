+#[test]
+fn test_henkan_sands_move_does_not_launch_or_leave_shift_held() {
+    let config = indoc! {"
+        virtual_modifiers: [F14]
+        modmap:
+            - remap:
+                HENKAN: F14
+                Space:
+                    held: Shift_L
+                    alone: Space
+                    alone_timeout_millis: 999999999999
+        keymap:
+            - exact_match: true
+              remap:
+                F14-Space: { launch: [launcher] }
+                Shift-F14-D: { launch: [move-right] }
+    "};
+    let henkan = Key::KEY_HENKAN;
+    let space = Key::KEY_SPACE;
+    let d = Key::KEY_D;
+    for space_first in [false, true] {
+        for releases in [[henkan, space, d], [henkan, d, space], [space, henkan, d],
+                         [space, d, henkan], [d, henkan, space], [d, space, henkan]] {
+            let mut handler = crate::tests::EventHandlerForTest::new(config);
+            let presses = if space_first { [space, henkan, d] } else { [henkan, space, d] };
+            handler.assert(presses.into_iter().map(Event::key_press).collect(), vec![
+                Action::KeyEvent(KeyEvent::new(Key::KEY_LEFTSHIFT, KeyValue::Press)),
+                Action::Command(vec!["move-right".to_string()]),
+            ]);
+            for key in releases {
+                let actions = if key == henkan { vec![] } else {
+                    vec![Action::KeyEvent(KeyEvent::new(if key == space { Key::KEY_LEFTSHIFT } else { key }, KeyValue::Release))]
+                };
+                handler.assert(vec![Event::key_release(key)], actions);
+            }
+            handler.assert_base_state();
+        }
+    }
+}
