+#[test]
+fn test_henkan_space_tap_is_independent_of_release_order() {
+    let config = indoc! {"
+        virtual_modifiers: [F14]
+        modmap:
+            - remap:
+                HENKAN: F14
+                Space:
+                    held: Shift_L
+                    alone: Space
+                    alone_timeout_millis: 999999999999
+        keymap:
+            - exact_match: true
+              remap:
+                F14-Space: { launch: [launcher] }
+    "};
+    for henkan_first in [false, true] {
+        let mut handler = crate::tests::EventHandlerForTest::new(config);
+        handler.assert(vec![Event::key_press(Key::KEY_HENKAN), Event::key_press(Key::KEY_SPACE)], vec![]);
+        let releases = if henkan_first { [Key::KEY_HENKAN, Key::KEY_SPACE] } else { [Key::KEY_SPACE, Key::KEY_HENKAN] };
+        handler.assert(releases.into_iter().map(Event::key_release).collect(), vec![
+            Action::Command(vec!["launcher".to_string()]),
+            Action::KeyEvent(KeyEvent::new(Key::KEY_SPACE, KeyValue::Release)),
+        ]);
+        handler.assert_base_state();
+        // The completed shortcut must not change subsequent ordinary spaces.
+        handler.assert(vec![Event::key_press(Key::KEY_SPACE), Event::key_release(Key::KEY_SPACE)], vec![
+            Action::KeyEvent(KeyEvent::new(Key::KEY_SPACE, KeyValue::Press)),
+            Action::KeyEvent(KeyEvent::new(Key::KEY_SPACE, KeyValue::Release)),
+        ]);
+        handler.assert_base_state();
+    }
+}
