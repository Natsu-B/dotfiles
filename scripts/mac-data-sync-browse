#!/usr/bin/env bash
set -euo pipefail
# Lightweight browser: each view lists only immediate children. No recursive
# SSH tree traversal until an actual sync is created for a chosen directory.
mode=${1:-mac}
action=${2:-pick}
[[ "$mode" == mac || "$mode" == linux ]] || { echo 'Invalid browser mode' >&2; exit 2; }
[[ "$action" == pick || "$action" == ls ]] || { echo 'Invalid browser action' >&2; exit 2; }
cli=${MAC_DATA_SYNC_BIN:-mac-data-sync}
remote=${MAC_DATA_REMOTE:-mac}
[[ "$remote" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo 'Invalid MAC_DATA_REMOTE' >&2; exit 2; }
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=8)

valid_path() {
  local path=$1 part
  [[ "$path" != /* && "$path" != */ && "$path" != *'//'*
     && "$path" != *:* && "$path" != *[$'\n\r\t']* ]] || return 1
  [[ -z "$path" ]] && return 0
  local parts=()
  IFS='/' read -r -a parts <<< "$path"
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != . && "$part" != .. ]] || return 1
  done
}

remote_entries() {
  local path=$1 encoded
  encoded=$(printf '%s' "$path" | base64 -w 0)
  ssh "${ssh_opts[@]}" "$remote" "MAC_REL_B64=$encoded /bin/bash -s" <<'REMOTE'
set -euo pipefail
cd "$HOME/data"
relative=$(printf %s "$MAC_REL_B64" | /usr/bin/base64 -D)
# Never follow symlinks to paths outside the Mac archive.
if [[ -n "$relative" ]]; then
  IFS='/' read -r -a parts <<< "$relative"
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != . && "$part" != .. &&
       "$part" != *:* && "$part" != *[$'\n\r\t']* && ! -L "$part" ]] || exit 2
    cd -- "$part"
  done
fi
# This only reads the current directory, including dotfiles, once per view.
# No traversal of children; selected directories are later synced recursively.
/usr/bin/find . -mindepth 1 -maxdepth 1 -print0 |
while IFS= read -r -d '' entry; do
  name=${entry#./}
  [[ "$name" != *:* && "$name" != *[$'\n\r\t']* ]] || continue
  if [[ -d "$entry" && ! -L "$entry" ]]; then
    printf 'D\t%s\0' "$name"
  elif [[ -f "$entry" && ! -L "$entry" ]]; then
    printf 'F\t%s\0' "$name"
  fi
done
REMOTE
}

linux_entries() {
  local relative=$1 dir=$HOME/work part
  [[ ! -L "$HOME/work" ]] || { echo 'Refusing to browse a symlinked ~/work' >&2; return 2; }
  mkdir -p -- "$HOME/work"
  if [[ -n "$relative" ]]; then
    local parts=()
    IFS='/' read -r -a parts <<< "$relative"
    for part in "${parts[@]}"; do
      [[ ! -L "$dir/$part" && -d "$dir/$part" ]] || return 2
      dir="$dir/$part"
    done
  fi
  ( cd -- "$dir"
    find . -mindepth 1 -maxdepth 1 -print0 |
    while IFS= read -r -d '' entry; do
      name=${entry#./}
      [[ "$name" != *:* && "$name" != *[$'\n\r\t']* ]] || continue
      if [[ -d "$entry" && ! -L "$entry" ]]; then
        printf 'D\t%s\0' "$name"
      elif [[ -f "$entry" && ! -L "$entry" ]]; then
        printf 'F\t%s\0' "$name"
      fi
    done )
}

entries() {
  if [[ "$mode" == mac ]]; then remote_entries "$1"; else linux_entries "$1"; fi
}

# ls defaults to current root and accepts an optional subdirectory.
if [[ "$action" == ls ]]; then
  current=${3:-}
  valid_path "$current" || exit 2
  tmp=$(mktemp)
  trap 'rm -f -- "$tmp"' EXIT
  entries "$current" > "$tmp"
  while IFS= read -r -d '' row; do
    kind=${row%%$'\t'*}
    name=${row#*$'\t'}
    if [[ "$kind" == D ]]; then printf '%s/\n' "$name"; else printf '%s\n' "$name"; fi
  done < "$tmp"
  exit 0
fi

current=''
tmp_dir=$(mktemp -d)
trap 'rm -rf -- "$tmp_dir"' EXIT
declare -a selected=()

sync_selected() {
  local path ans p previous skip plan
  declare -a paths=() collapsed=()
  for path in "${selected[@]}"; do
    valid_path "$path" || { echo "Unsupported path: $path" >&2; return 1; }
    skip=0
    for previous in "${selected[@]}"; do
      if [[ "$path" != "$previous" && "$path" == "$previous/"* ]]; then skip=1; break; fi
    done
    (( skip )) && continue
    for previous in "${collapsed[@]}"; do
      [[ "$previous" == "$path" ]] && { skip=1; break; }
    done
    (( skip )) || collapsed+=("$path")
  done
  (( ${#collapsed[@]} )) || return 0
  # Explain existing entries before asking to create anything. Inspecting or
  # reselecting a registered path must never terminate or recreate its session.
  for p in "${collapsed[@]}"; do
    plan=$("$cli" check --json "$p") || return 1
    if [[ "$(jq -r '.action' <<< "$plan")" == create ]]; then
      paths+=("$p")
    else
      "$cli" check "$p" || true
    fi
  done
  if (( ${#paths[@]} == 0 )); then
    printf '\nNo new synchronization to start. Manage existing entries in Working copies.\n' >&2
    return 0
  fi
  printf '\nCreate new synchronization for:\n' >&2
  for p in "${paths[@]}"; do
    if [[ "$mode" == mac ]]; then
      printf '  Mac ~/data/%s -> Linux ~/work/%s\n' "$p" "$p" >&2
    else
      printf '  Linux ~/work/%s -> Mac ~/data/%s\n' "$p" "$p" >&2
    fi
  done
  printf 'After setup, edits synchronize in both directions.\n' >&2
  printf 'Start? [y/N] ' >&2
  IFS= read -r ans || return 0
  [[ "$ans" == y || "$ans" == Y ]] || return 0
  for p in "${paths[@]}"; do
    "$cli" start "$p" || return 1
  done
}

while true; do
  valid_path "$current" || exit 2
  entries "$current" > "$tmp_dir/entries" || {
    echo 'Unable to list directory. Check SSH and permissions.' >&2
    exit 1
  }
  : > "$tmp_dir/options"
  [[ -n "$current" ]] && printf 'UP\t../\0SYNC\t./ (sync this folder)\0' >> "$tmp_dir/options"
  while IFS= read -r -d '' row; do
    kind=${row%%$'\t'*}
    name=${row#*$'\t'}
    if [[ "$kind" == D ]]; then
      printf 'OPEN\t%s/\0SYNC\t%s/ (sync recursively)\0' "$name" "$name" >> "$tmp_dir/options"
    else
      printf 'SYNC\t%s\0' "$name" >> "$tmp_dir/options"
    fi
  done < "$tmp_dir/entries"
  source_name='Mac ~/data'
  [[ "$mode" == linux ]] && source_name='Linux ~/work'
  file=$tmp_dir/result
  if ! fzf --read0 --print0 --multi --border --layout=reverse --height=90% \
     --delimiter=$'\t' --with-nth=1,2 \
     --prompt="$source_name/$current > " \
     --header='Enter: open directory or sync | Tab: select several SYNC rows | Esc: exit' \
     < "$tmp_dir/options" > "$file"; then
     exit 0
  fi
  declare -a rows=()
  while IFS= read -r -d '' row; do rows+=("$row"); done < "$file"
  (( ${#rows[@]} )) || continue
  selected=()
  nav=''
  for row in "${rows[@]}"; do
    kind=${row%%$'\t'*}
    label=${row#*$'\t'}
    case "$kind" in
      UP) nav=up ;;
      OPEN) nav="open:${label%/}" ;;
      SYNC)
        if [[ "$label" == './ (sync this folder)' ]]; then
          selected+=("$current")
        elif [[ "$label" == */' (sync recursively)' ]]; then
          leaf=${label%' (sync recursively)'}
          selected+=("${current:+$current/}${leaf%/}")
        else
          selected+=("${current:+$current/}$label")
        fi
        ;;
    esac
  done
  if [[ -n "$nav" && ${#rows[@]} -ne 1 ]]; then
    echo 'Select either one navigation row or one/more sync rows.' >&2
    continue
  fi
  if [[ "$nav" == up ]]; then
    if [[ "$current" == */* ]]; then current=${current%/*}; else current=''; fi
  elif [[ "$nav" == open:* ]]; then
    leaf=${nav#open:}
    current="${current:+$current/}$leaf"
  elif (( ${#selected[@]} )); then
    sync_selected || exit 1
  fi
done
