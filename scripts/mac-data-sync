#!/usr/bin/env bash
set -euo pipefail

# Run on NixOS. Mac's ~/data is the archive; ~/work holds selected working copies.
usage() {
  cat >&2 <<'USAGE'
Usage: mac-data-sync                      Open interactive management dashboard
       mac-data-sync menu                 Open interactive management dashboard
       mac-data-sync pick                 Select files/directories from Mac with fzf
       mac-data-sync ls [relative-dir]    List one Mac directory (nonrecursive)
       mac-data-sync browse-local         Browse Linux ~/work and sync to Mac
       mac-data-sync start <relative-path> Copy one file or the full directory tree to ~/work
       mac-data-sync {status|flush|pause|resume|terminate} <relative-path>
       mac-data-sync release <relative-path> Safely delete only Linux copy after verification
       mac-data-sync list                 List Mutagen sessions

Example: mac-data-sync start documents/report.pdf

Environment:
  MAC_DATA_REMOTE=mac    SSH alias for Mac (configured in NixOS ~/.ssh/config)
  Browse: Enter opens a directory, select SYNC to copy its full subtree.

Selecting a directory copies ALL descendants, including hidden files and .git.
The initial copy waits for completion. Later edits sync automatically.
Linux files are never automatically cleaned up from ~/work.
The release command requires explicit confirmation and a full checksum match.
Within a running two-way session, ordinary deletions DO synchronize to Mac.
USAGE
}

fail() { printf 'mac-data-sync: %s\n' "$*" >&2; exit 1; }

remote=${MAC_DATA_REMOTE:-mac}
[[ "$remote" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail 'Invalid MAC_DATA_REMOTE (use an SSH host alias)'
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/mac-data-sync
work_dir=$HOME/work
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=8)

validate_path() {
  local path=$1 component
  [[ -n "$path" && "$path" != /* && "$path" != */ && "$path" != *'//'*
      && "$path" != *:* && "$path" != *[$'\n\r\t']* ]] || fail "Invalid relative path: $(printf %q "$path")"
  local components=()
  IFS='/' read -r -a components <<< "$path"
  for component in "${components[@]}"; do
    [[ -n "$component" && "$component" != '.' && "$component" != '..' ]] || fail "Unsafe path: $(printf %q "$path")"
  done
}

session_id() {
  local hash
  hash=$(printf '%s' "$1" | sha256sum)
  hash=${hash%% *}
  printf 'mac-data-%s' "${hash:0:20}"
}

# Shallow remote probe, never scanning the Mac subtree. File paths are
# passed as base64, not interpolated into remote shell source.
remote_type() {
  local encoded
  encoded=$(printf '%s' "$1" | base64 -w 0)
  ssh "${ssh_opts[@]}" "$remote" "MAC_REL_B64=$encoded /bin/bash -s" <<'REMOTE'
set -euo pipefail
relative=$(printf %s "$MAC_REL_B64" | /usr/bin/base64 -D)
root="$HOME/data"
[[ ! -L "$root" ]] || exit 2
[[ -d "$root" ]] || { printf missing; exit 0; }
cd -- "$root"
IFS='/' read -r -a parts <<< "$relative"
last=$((${#parts[@]}-1))
for ((i=0; i<=last; i++)); do
  part=${parts[i]}
  [[ -n "$part" && "$part" != . && "$part" != .. &&
     "$part" != *:* && "$part" != *[$'\t\r\n']* &&
     ! -L "$part" ]] || exit 2
  [[ -e "$part" ]] || { printf missing; exit 0; }
  if (( i<last )); then
    cd -- "$part" || exit 2
  else
    if [[ -d "$part" ]]; then printf directory
    elif [[ -f "$part" ]]; then printf file
    else exit 2; fi
  fi
done
REMOTE
}

# Create only missing Mac parent folders. Mutagen creates the missing final
# path from Linux data; we do not create an empty competing sync root.
prepare_remote_parent() {
  local encoded
  encoded=$(printf '%s' "$1" | base64 -w 0)
  ssh "${ssh_opts[@]}" "$remote" "MAC_REL_B64=$encoded /bin/bash -s" <<'REMOTE'
set -euo pipefail
relative=$(printf %s "$MAC_REL_B64" | /usr/bin/base64 -D)
root="$HOME/data"
[[ ! -L "$root" ]] || exit 2
[[ -e "$root" ]] || mkdir -- "$root"
[[ -d "$root" && ! -L "$root" ]] || exit 2
cd -- "$root"
IFS='/' read -r -a parts <<< "$relative"
last=$((${#parts[@]}-1))
for ((i=0; i<last; i++)); do
  part=${parts[i]}
  [[ -n "$part" && "$part" != . && "$part" != .. &&
     "$part" != *:* && "$part" != *[$'\t\r\n']* &&
     ! -L "$part" ]] || exit 2
  [[ -e "$part" ]] || mkdir -- "$part"
  [[ -d "$part" && ! -L "$part" ]] || exit 2
  cd -- "$part"
done
leaf=${parts[last]}
[[ -n "$leaf" && "$leaf" != . && "$leaf" != .. &&
   "$leaf" != *:* && "$leaf" != *[$'\t\r\n']* &&
   ! -e "$leaf" && ! -L "$leaf" ]] || exit 2
REMOTE
}

check_overlapping_state() {
  local relative=$1 old f
  [[ -d "$state_dir" ]] || return 0
  for f in "$state_dir"/*; do
    [[ -f "$f" ]] || continue
    old=$(< "$f")
    if [[ "$old" == "$relative" || "$old" == "$relative/"* || "$relative" == "$old/"* ]]; then
      fail "Overlapping/duplicate session with $old; terminate it first."
    fi
  done
}

start_sync() {
  local relative=$1 kind mac_kind linux_kind session target cursor part
  validate_path "$relative"
  check_overlapping_state "$relative"
  mac_kind=$(remote_type "$relative") || fail "Cannot inspect Mac path ~/data/$relative (check SSH and permissions)"
  [[ "$mac_kind" == file || "$mac_kind" == directory || "$mac_kind" == missing ]] ||
    fail "Unsupported Mac type for $relative"

  [[ ! -L "$work_dir" ]] || fail "$work_dir is a symlink; refusing to write outside ~/work"
  mkdir -p -- "$work_dir"
  cursor=$work_dir
  local parts=()
  IFS='/' read -r -a parts <<< "$relative"
  for part in "${parts[@]}"; do
    cursor="$cursor/$part"
    [[ ! -L "$cursor" ]] || fail "Path contains a Linux symlink: $cursor"
  done
  target="$work_dir/$relative"
  linux_kind=missing
  if [[ -d "$target" ]]; then linux_kind=directory
  elif [[ -f "$target" ]]; then linux_kind=file
  elif [[ -e "$target" ]]; then fail "Unsupported Linux file type: $target"; fi

  if [[ "$mac_kind" == missing ]]; then
    [[ "$linux_kind" != missing ]] ||
      fail "Neither Mac ~/data/$relative nor Linux ~/work/$relative exists"
    kind=$linux_kind
    prepare_remote_parent "$relative" ||
      fail "Could not prepare missing Mac parent or Mac path changed"
    printf 'Mac path is absent; synchronizing the existing Linux copy to Mac.\n' >&2
  else
    kind=$mac_kind
    [[ "$linux_kind" == missing || "$linux_kind" == "$kind" ]] ||
      fail "Mac and Linux file types differ: $relative"
  fi
  if [[ "$kind" == directory ]]; then
    [[ ! -e "$target" || -d "$target" ]] || fail "Linux target is not a directory: $target"
    mkdir -p -- "$target"
  else
    [[ ! -e "$target" || -f "$target" ]] || fail "Linux target is not a file: $target"
    mkdir -p -- "$(dirname "$target")"
  fi

  session=$(session_id "$relative")
  printf 'Sync: %s:~/data/%s <=> %s\n' "$remote" "$relative" "$target" >&2
  # The selected directory root is recursively synchronized. Picker depth
  # limits only the list displayed by fzf, never the copied directory depth.
  # Override global ignores and propagate VCS as part of the directory tree.
  printf 'Copying Mac %s recursively into Linux %s ...\n' "$relative" "$target" >&2
  mutagen sync create --name="$session" --sync-mode=two-way-safe \
    --no-global-configuration --no-ignore-vcs \
    "$remote:~/data/$relative" "$target"
  mkdir -p -- "$state_dir"
  printf '%s\n' "$relative" > "$state_dir/$session"

  # Wait for the first complete cycle before saying the copy is ready.
  # On failure, retain the session and the downloaded data for reconnection.
  if ! mutagen sync flush "$session"; then
    printf 'Initial copy is incomplete; session remains active. Inspect: mac-data-sync status %s\n' "$relative" >&2
    return 1
  fi
  local snapshot
  if ! snapshot=$(mutagen sync list --template '{{json .}}' "$session") ||
    ! jq -e --arg name "$session" '
      type == "array" and length == 1 and
      .[0].name == $name and .[0].paused == false and
      (.[0].status == "watching" or .[0].status == 6) and
      (.[0].successfulCycles // 0) > 0 and
      .[0].alpha.connected == true and .[0].beta.connected == true and
      .[0].alpha.scanned == true and .[0].beta.scanned == true and
      (.[0].lastError // "") == "" and
      ((.[0].conflicts // []) | length) == 0 and
      (.[0].excludedConflicts // 0) == 0 and
      ((.[0].alpha.scanProblems // []) | length) == 0 and
      ((.[0].beta.scanProblems // []) | length) == 0 and
      ((.[0].alpha.transitionProblems // []) | length) == 0 and
      ((.[0].beta.transitionProblems // []) | length) == 0 and
      (.[0].alpha.excludedScanProblems // 0) == 0 and
      (.[0].beta.excludedScanProblems // 0) == 0 and
      (.[0].alpha.excludedTransitionProblems // 0) == 0 and
      (.[0].beta.excludedTransitionProblems // 0) == 0
    ' <<< "$snapshot" >/dev/null; then
    printf 'Initial copy could not be verified; session remains active. Inspect: mac-data-sync status %s\n' "$relative" >&2
    return 1
  fi
  printf 'Ready: Mac ~/data/%s <=> Linux ~/work/%s (all descendants)\n' "$relative" "$relative"
}

(( $# > 0 )) || set -- menu
command=$1
shift
case "$command" in
  menu)
    (( $# == 0 )) || { usage; exit 2; }
    exec mac-data-sync-ui
    ;;
  release)
    (( $# == 1 )) || { usage; exit 2; }
    validate_path "$1"
    exec mac-data-sync-release "$1"
    ;;
  pick)
    (( $# == 0 )) || { usage; exit 2; }
    exec mac-data-sync-browse mac pick
    ;;
  ls)
    (( $# <= 1 )) || { usage; exit 2; }
    exec mac-data-sync-browse mac ls "${1:-}"
    ;;
  browse-local)
    (( $# == 0 )) || { usage; exit 2; }
    exec mac-data-sync-browse linux pick
    ;;
  start)
    (( $# == 1 )) || { usage; exit 2; }
    start_sync "$1"
    ;;
  list)
    (( $# == 0 )) || { usage; exit 2; }
    exec mutagen sync list
    ;;
  status|flush|pause|resume|terminate)
    (( $# == 1 )) || { usage; exit 2; }
    validate_path "$1"
    session=$(session_id "$1")
    if [[ "$command" == status ]]; then
      exec mutagen sync list --long "$session"
    elif [[ "$command" == terminate ]]; then
      mutagen sync terminate "$session"
      rm -f -- "$state_dir/$session" # metadata only; neither copy is deleted
    else
      exec mutagen sync "$command" "$session"
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
